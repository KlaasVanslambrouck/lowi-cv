# Kopieer dit bestand naar .env.local en vul de waarden in.
#
# Supabase wordt gebruikt voor beheer-login en portfolio_analytics.
# NEXT_PUBLIC_NIDUS_API_URL wijst naar nidus-api voor de Jarvis Q&A-widget
# koppeling met een publieke read-only endpoint.
#
# NIDUS_API_URL is dezelfde nidus-api, maar server-side: next.config.ts gebruikt
# ze enkel voor de rewrite /cv.pdf -> ${NIDUS_API_URL}/api/portfolio/cv-pdf.
# Bewust zonder NEXT_PUBLIC_-prefix: deze waarde hoort niet in de browserbundel.
# Ontbreekt ze, dan bestaat /cv.pdf niet (404) en waarschuwt de build.
#
# NEXT_PUBLIC_SITE_URL is de canonieke basis-URL van de publieke site
# (bv. https://lowiklaasvanslambrouck.vercel.app of een eigen domein).
# Wordt gebruikt voor robots.txt, sitemap.xml en absolute URL's (lib/site.ts).
# Zonder protocol wordt https:// aangenomen; een trailing slash wordt weggehaald.
# Leeg = fallback https://lowiklaasvanslambrouck.vercel.app.
# Wordt tijdens de build ingelijnd: na een wijziging opnieuw builden/deployen.
#
# LET OP: client-side code mag enkel NEXT_PUBLIC_* variabelen gebruiken.
# SUPABASE_SERVICE_ROLE_KEY is server-only: nooit NEXT_PUBLIC_ prefix,
# nooit importeren in client components, enkel gebruiken in app/api/*/route.ts.
# ENABLE_HSTS is alleen nodig buiten Vercel production, en alleen achter HTTPS.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_NIDUS_API_URL=
NIDUS_API_URL=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENABLE_HSTS=
